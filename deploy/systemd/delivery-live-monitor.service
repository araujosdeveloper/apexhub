[Unit]
Description=Verifica HTTPS API e idade dos backups Apex Delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /root/delivery-saas/scripts/monitor-live.py
TimeoutStartSec=90
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/root/delivery-saas/reports
