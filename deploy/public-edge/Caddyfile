{
	email {$ACME_EMAIL}
	default_sni {$PUBLIC_IP}
	on_demand_tls {
		ask http://delivery-domain-check:3000/api/internal/domain-cert
	}
}

https://{$PUBLIC_IP} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	import /etc/caddy/routes/*.caddy
}

https://apexdelivery.com.br, https://www.apexdelivery.com.br, https:// {
	tls {
		on_demand
	}
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	import /etc/caddy/routes/*.caddy
}
