PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=delivery_app
DB_PASSWORD=preencha-com-uma-senha-forte
DB_NAME=delivery_saas_db
SECURE_COOKIES=false

# Gere duas chaves independentes com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# JWT_TENANT_SECRET=
# JWT_MASTER_SECRET=

# Opcional: preços mensais em BRL para MRR estimado. Ajuste aos contratos reais.
# PLAN_PRICES_JSON={"starter":"99.90"}

# Importação inteligente (opcional; no Docker de produção use .env.ai privado)
# OPENAI_API_KEY=
# MENU_IMPORT_AI_MODEL=gpt-4.1-mini
