# Copie para .env.docker e preencha com duas senhas fortes e diferentes.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
APP_PORT=3001

# Domínio público usado para os subdomínios de lojas.
PUBLIC_BASE_DOMAIN=apexdelivery.com.br

# WhatsApp Embedded Signup. Preencha no ambiente do servidor para liberar a conexão.
WHATSAPP_META_APP_ID=
WHATSAPP_META_CONFIG_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_GRAPH_VERSION=
# Chave AES-256 em hexadecimal (32 bytes). Guarde-a junto à configuração protegida.
WHATSAPP_CONNECTION_KEY=

WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# O piloto responde somente ao telefone autorizado nesta empresa.
WHATSAPP_REPLY_PILOT_COMPANY_ID=
WHATSAPP_REPLY_PILOT_SENDER=

# Opcional: use um modelo Responses API com saída estruturada para pedidos em texto livre.
WHATSAPP_AI_MODEL=

# Avisos de status. O mesmo modelo aprovado deve existir na conta de cada loja.
WHATSAPP_ORDER_NOTICES=false
WHATSAPP_ORDER_NOTICE_TEMPLATE=
WHATSAPP_ORDER_NOTICE_LANGUAGE=pt_BR
